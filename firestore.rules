rules_version = '2';
// Firestore — SNS 모니터링(sns-tool.html) 전용 (2026-09-29)
// 로그인 + sns_allow/{uid} 명단에 있는 계정만 읽기·쓰기.
// 명단은 정글 본체(app.js syncSnsAllowList)가 마스터 로그인 시 RTDB /accounts에서 자동 복사.
// BOOTSTRAP_MASTER: 명단이 비어 있을 때 첫 동기화를 할 수 있게 하는 현재 마스터 uid.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function allowed(){
      return signedIn() && exists(/databases/$(database)/documents/sns_allow/$(request.auth.uid));
    }
    function isMaster(){
      return signedIn() && (
        request.auth.uid == 'YOUR_MASTER_UID' ||   // 마스터 계정의 사용자 UID(Firebase 콘솔 > Authentication > 사용자). HANDOVER.md "이어서 할 일" 3번
        (allowed() && get(/databases/$(database)/documents/sns_allow/$(request.auth.uid)).data.master == true)
      );
    }
    match /sns_allow/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMaster());
      allow write: if isMaster();
    }
    match /politicians/{docId} { allow read, write: if allowed(); }
    match /sns_u/{ns} { allow read, write: if allowed(); }
    match /sns_u/{ns}/{document=**} { allow read, write: if allowed(); }
  }
}
